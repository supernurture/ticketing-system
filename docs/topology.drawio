        <mxCell id="api" value="&lt;b&gt;Go API × N&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#374151&quot;&gt;stateless (JWT, tanpa session)&lt;br&gt;tambah server saat film baru rilis&lt;br&gt;login · jadwal · booking · bayar&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=15;arcSize=10;strokeWidth=2;" vertex="1" parent="laneA">
