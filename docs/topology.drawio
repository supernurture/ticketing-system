        <mxCell id="laneX" value="🔌 Layanan Luar" style="swimlane;html=1;startSize=36;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=16;fontStyle=1;fontColor=#92400E;rounded=1;arcSize=5;swimlaneFillColor=#FFFCF3;" vertex="1" parent="1">
          <mxGeometry x="1290" y="100" width="230" height="560" as="geometry" />
        </mxCell>
        <mxCell id="pay" value="💳 Payment Gateway&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6B7280&quot;&gt;QRIS · VA · e-wallet&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;arcSize=16;" vertex="1" parent="laneX">
          <mxGeometry x="20" y="190" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="msg" value="📨 Email / WhatsApp&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6B7280&quot;&gt;e-tiket, notifikasi refund&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=14;arcSize=16;" vertex="1" parent="laneX">
          <mxGeometry x="20" y="475" width="190" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="aset statis" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0284C7;strokeWidth=2;endArrow=block;endFill=1;dashed=1;fontSize=11;fontColor=#075985;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cw" target="cdn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cw" target="lb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="215" /><mxPoint x="300" y="380" /></Array></mxGeometry></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cm" target="lb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="300" /><mxPoint x="300" y="380" /></Array></mxGeometry></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ad" target="lb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="530" /><mxPoint x="300" y="380" /></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="lb" target="api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="tulis" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;fontColor=#166534;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.8;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="api" target="pg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="baca" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#16A34A;strokeWidth=2;endArrow=block;endFill=1;dashed=1;fontSize=11;fontColor=#166534;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="api" target="rep"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="409" /><mxPoint x="940" y="540" /></Array></mxGeometry></mxCell>
        <mxCell id="e8" value="replikasi" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#16A34A;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;fontSize=11;fontColor=#166534;labelBackgroundColor=#F6FEF9;" edge="1" parent="1" source="pg" target="rep"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="bayar / callback" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=11;fontColor=#92400E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="api3" target="pay"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="782" y="170" /><mxPoint x="1405" y="170" /></Array></mxGeometry></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563EB;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="wk" target="pg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="962" y="488" /><mxPoint x="962" y="440" /><mxPoint x="1069" y="440" /></Array></mxGeometry></mxCell>
        <mxCell id="e11" value="refund" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D97706;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;fontSize=11;fontColor=#92400E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="w2" target="pay"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="568" /><mxPoint x="940" y="655" /><mxPoint x="1260" y="655" /><mxPoint x="1260" y="325" /></Array></mxGeometry></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#D97706;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.71;entryDx=0;entryDy=0;" edge="1" parent="1" source="w3" target="msg"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="965" y="523" /><mxPoint x="965" y="625" /></Array></mxGeometry></mxCell>

        <mxCell id="n1" value="&lt;b&gt;🔒 Kursi tidak bisa terjual dua kali&lt;/b&gt;&lt;br&gt;Booking mengunci kursi lewat satu UPDATE bersyarat di PostgreSQL Primary. Dua customer menekan &lt;i&gt;Pesan&lt;/i&gt; di detik yang sama → hanya satu yang berhasil, di server API mana pun mereka masuk." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontSize=13;align=left;spacing=12;arcSize=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="690" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;⚡ Tetap cepat saat ramai&lt;/b&gt;&lt;br&gt;Membuka jadwal &amp;amp; denah kursi (paling sering) dibaca dari replica. Hanya booking &amp;amp; bayar yang menulis ke primary. API stateless, jadi cukup tambah server di belakang load balancer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;fontSize=13;align=left;spacing=12;arcSize=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="530" y="690" width="480" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;♻️ Restok &amp;amp; refund otomatis&lt;/b&gt;&lt;br&gt;Booking yang tidak dibayar 15 menit otomatis melepas kursinya setelah 1 menit masa tenggang, tanpa job terjadwal. Jadwal dibatalkan bioskop → worker me-refund lewat payment gateway dan mengirim notifikasi ke customer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=13;align=left;spacing=12;arcSize=8;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1030" y="690" width="490" height="110" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="── request &amp;nbsp;&amp;nbsp;&amp;nbsp; - - - asinkron / replikasi" style="text;html=1;fontSize=12;fontColor=#6B7280;align=right;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1220" y="815" width="300" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
