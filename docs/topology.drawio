        <mxCell id="laneE" value="🛡️ Pintu Masuk" style="swimlane;html=1;startSize=36;fillColor=#E0F2FE;strokeColor=#0284C7;fontSize=16;fontStyle=1;fontColor=#075985;rounded=1;arcSize=5;swimlaneFillColor=#F5FBFF;" vertex="1" parent="1">
          <mxGeometry x="330" y="100" width="230" height="560" as="geometry" />
        </mxCell>
        <mxCell id="cdn" value="☁️ CDN&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6B7280&quot;&gt;poster film &amp;amp; aset statis,&lt;br&gt;dekat dengan tiap kota&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;fontSize=14;arcSize=16;" vertex="1" parent="laneE">
