<mxfile host="app.diagrams.net">
  <diagram id="topology" name="Topologi Sistem">
    <mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1540" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="🖧 Topologi Sistem Tiket Bioskop Nasional" style="text;html=1;fontSize=26;fontStyle=1;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="760" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Satu platform untuk semua cabang di berbagai kota. Server aplikasi bisa ditambah saat ramai; database menjaga kursi agar tidak pernah terjual dua kali." style="text;html=1;fontSize=14;fontColor=#6B7280;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="48" width="1100" height="26" as="geometry" />
        </mxCell>

        <mxCell id="laneU" value="👥 Pengguna" style="swimlane;html=1;startSize=36;fillColor=#EEF2FF;strokeColor=#6366F1;fontSize=16;fontStyle=1;fontColor=#3730A3;rounded=1;arcSize=5;swimlaneFillColor=#F8F9FF;" vertex="1" parent="1">
          <mxGeometry x="30" y="100" width="240" height="560" as="geometry" />
        </mxCell>
        <mxCell id="cw" value="🌐 Customer&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6B7280&quot;&gt;web browser&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6366F1;fontSize=14;arcSize=16;" vertex="1" parent="laneU">
          <mxGeometry x="20" y="70" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cm" value="📱 Customer&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6B7280&quot;&gt;aplikasi mobile&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6366F1;fontSize=14;arcSize=16;" vertex="1" parent="laneU">
          <mxGeometry x="20" y="170" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ad" value="🧑‍💼 Admin bioskop&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#6B7280&quot;&gt;cabang di tiap kota:&lt;br&gt;kelola &amp;amp; batalkan jadwal&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6366F1;fontSize=14;arcSize=16;" vertex="1" parent="laneU">
          <mxGeometry x="20" y="380" width="200" height="100" as="geometry" />
