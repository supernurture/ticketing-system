        <mxCell id="pg" value="&lt;b&gt;PostgreSQL Primary&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#374151&quot;&gt;booking, pembayaran,&lt;br&gt;kunci kursi atomik&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#FFFFFF;strokeColor=#16A34A;fontSize=14;strokeWidth=2;" vertex="1" parent="laneD">
