        <mxCell id="laneD" value="🗄️ Data" style="swimlane;html=1;startSize=36;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=16;fontStyle=1;fontColor=#166534;rounded=1;arcSize=5;swimlaneFillColor=#F6FEF9;" vertex="1" parent="1">
